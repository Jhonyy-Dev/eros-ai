# Copia este archivo a .env y pon tu clave real. El .env nunca va al repo.
API_KEY=

# --- Eros web ---
MODELO_ACTIVO=deepseek-v4.1-flash
BACKEND=openrouter
FALLBACK_LOCAL=true
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
HTTP_REFERER=https://eros.local
PUERTO=8090
LOCAL_URL=http://127.0.0.1:8099
LOCAL_KEY=

MAX_TOKENS=20000
MAX_MENSAJES_CONTEXTO=20
MAX_TOKENS_CONTEXTO=32000
LIMITE_MENSAJES_DIA=10
LIMITE_MENSAJES_MINUTO=8

# Carpeta de datos (llaves, uso y tabla de alumnos). En hosting: /tmp/datos o el volumen.
DATOS_DIR=
LOGS_DIR=
# Cuantas llaves de la serie derivada del SESSION_SECRET se pueden repartir.
LLAVES_SERIE=400
# Cuantos caracteres retiene el servidor antes de mandar cada trozo (menos = la primera letra
# llega antes; la fluidez del chat la maneja el navegador).
COLA_RETENCION=48

SESSION_SECRET=
ALUMNOS=profe:eros2026
ENABLE_STUDENT_API_KEYS=false
LOG_KEYS=false
ADMIN_USER=profe
ADMIN_CLAVE=

# Solo para subir a Hugging Face con scripts\subir_hf.py (no va al repo).
HF_TOKEN=
